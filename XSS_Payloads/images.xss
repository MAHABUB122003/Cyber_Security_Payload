</svg>
EOF

# 9. URL Encoded
cat > 9-url-encode.svg << 'EOF'
<svg onload="%61%6c%65%72%74%28%31%29">
    <rect width="100" height="100" fill="brown"/>
</svg>
EOF

# 10. Line Break Bypass
cat > 10-linebreak.svg << 'EOF'
